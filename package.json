{
  "name": "epub-reader",
  "version": "0.1.0",
  "private": true,
  "description": "A private, offline EPUB reader for Windows",
  "author": "Atharv Goel",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron . --dev\"",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "dist": "npm run build && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "epubjs": "0.3.93",
    "jszip": "3.10.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^42.0.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "com.atharvgoel.epubreader",
    "productName": "EPUB Reader",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/**/*", "package.json"],
    "win": { "target": "nsis" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
