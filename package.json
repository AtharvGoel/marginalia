{
  "name": "epub-reader",
  "version": "0.3.1",
  "private": true,
  "description": "Marginalia — a personal, offline EPUB reader for Windows",
  "author": "Atharv Goel",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron . --dev\"",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "start": "electron .",
    "test": "node --test tests/storage.test.cjs tests/database.test.cjs tests/library-service.test.cjs tests/metadata.test.cjs tests/preferences.test.cjs tests/identity.test.cjs",
    "dist": "npm run build && electron-builder --win nsis --x64",
    "test:desktop": "node tests/desktop.cjs && node tests/bookshelf.cjs && node tests/comfort.cjs && node tests/branding.cjs",
    "test:installer": "node tests/installer.cjs"
  },
  "dependencies": {
    "@xmldom/xmldom": "0.9.12",
    "epubjs": "0.3.93",
    "jszip": "3.10.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^42.0.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "com.atharvgoel.epubreader",
    "productName": "Marginalia",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "shared/**/*",
      "branding/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "branding/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "uninstallDisplayName": "Marginalia",
      "createStartMenuShortcut": true,
      "createDesktopShortcut": true,
      "runAfterFinish": false,
      "shortcutName": "Marginalia"
    }
  },
  "overrides": {
    "minimatch": "11.0.1",
    "@xmldom/xmldom": "0.9.12"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "UNLICENSED",
  "productName": "Marginalia",
  "readerDataDirectory": "epub-reader"
}
